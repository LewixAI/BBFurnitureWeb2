# Where the assistant's API lives.
#
# Unset in production: this site is served by GitHub Pages, so the widget calls
# https://bigbrainsystem.lewix.ai/api/chat directly, cross-origin. That API's
# CHAT_ORIGINS must list this site's origin, and its CHAT_DIRECT_ORIGINS must
# too — nothing here can inject the shared secret a proxied site carries.
VITE_CHAT_API=http://localhost:3115/api/chat
